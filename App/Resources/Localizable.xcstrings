          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        }
      }
    },
    "Accessibility is not granted, so a recording would contain only app switches, launches and quits. Grant it in Permissions to record focus, values, menus and windows.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accessibilité n'est pas accordée : un enregistrement ne contiendrait que les changements, ouvertures et fermetures d'apps. Accordez-la dans Autorisations pour enregistrer le focus, les valeurs, les menus et les fenêtres."
          }
        }
      }
    },
