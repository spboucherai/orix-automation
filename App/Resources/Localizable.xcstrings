          }
        }
      }
    },
    "Open the workflow": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir le flux"
          }
        }
      }
    },
    "Opens the Agent section. Choose “%@” there to talk to it.": {
      "localizations": {
