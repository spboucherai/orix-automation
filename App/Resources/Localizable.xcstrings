      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exécution(s) en cours"
          }
        }
      }
    },
    "%@ step(s) from %@ action(s). Elements are found by role and title, never by position.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ étape(s) tirée(s) de %@ action(s). Les éléments sont repérés par leur rôle et leur titre, jamais par leur position."
          }
        }
      }
    },
    "%@ tool calls": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ appels d’outils"
          }
