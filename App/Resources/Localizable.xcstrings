    },
    "Items at the same time": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments traités en même temps"
          }
        }
      }
    },
    "Its instructions, tool grants and evaluation cases are removed. Workflows that name this agent will fail validation until you change them. Past runs are kept.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses instructions, ses outils autorisés et ses cas d'évaluation sont supprimés. Les flux qui nomment cet agent échoueront à la validation tant que vous ne les aurez pas modifiés. Les exécutions passées sont conservées."
          }
        }
      }
    },
    "Its own notes": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses propres notes"
          }
        }
      }
    },
    "Its stored source has errors. Open it in Code Studio to fix them.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
