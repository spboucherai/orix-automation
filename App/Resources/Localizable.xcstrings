    "%lld steps inside. Select this step and use Add to put another one in.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld étapes à l’intérieur. Sélectionnez cette étape et utilisez Ajouter pour en placer une autre."
