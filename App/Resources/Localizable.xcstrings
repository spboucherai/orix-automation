    },
    "%@ value(s) looked like a secret and were replaced by a placeholder.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ valeur(s) ressemblaient à un secret et ont été remplacées par un texte de substitution."
