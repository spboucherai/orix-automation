    "%@ of %@ tools. Each call is still checked against your grants and approved by tier.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ outils sur %@. Chaque appel reste vérifié selon vos autorisations et approuvé selon son niveau."
          }
        }
      }
    },
    "%@ record(s)": {
      "localizations": {
