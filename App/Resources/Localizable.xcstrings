{
  "sourceLanguage": "en",
  "strings": {
    "  … %lld times, last at %@": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "  … %lld fois, la dernière à %@"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ %@ is installed and available as %@.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ est installée et accessible sous %@."
          }
        }
      }
    },
    "%@ (%@)": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (%@)"
          }
        }
      }
    },
    "%@ (top level only)": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (premier niveau seulement)"
          }
        }
      }
    },
    "%@ action(s) kept": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ action(s) conservée(s)"
