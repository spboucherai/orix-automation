      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Des actions dont l'effet dépasse un fichier : envoyer sur le réseau, exécuter un script ou un programme, contrôler une app, pousser vers un dépôt. Approuvées chaque fois, sauf si une autorisation couvre ce niveau."
          }
        }
      }
