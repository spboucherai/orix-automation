    "%@ in · %@ out tokens": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jetons en entrée · %@ en sortie"
          }
        }
      }
    },
    "%@ is a protected location (credentials or system security data). No grant can cover it.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un emplacement protégé (identifiants ou données de sécurité du système). Aucune autorisation ne peut le couvrir."
          }
        }
      }
    },
    "%@ is a protected location and cannot be a working folder.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est un emplacement protégé et ne peut pas servir de dossier de travail."
          }
        }
      }
    },
    "%@ is back on version %@.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est revenue à la version %@."
          }
        }
      }
    },
    "%@ is not a JSON object.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas un objet JSON."
          }
        }
      }
    },
    "%@ is not an existing folder.": {
      "localizations": {
        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas un dossier existant."
          }
        }
      }
    },
